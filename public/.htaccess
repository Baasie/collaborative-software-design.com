# GENERATED by scripts/build-redirects.mjs, do not edit.
# Sources: data/legacy-redirects.csv (people), data/retired-urls.csv (the sync).
# Run `npm run redirects` after adding or renaming content.

Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Moved permanently.
  # WordPress author archive with a single author
  RewriteRule "^author/kenny/$" "/#authors" [R=301,NE,L]
  # WordPress category archive duplicating the Dear CoMo index
  RewriteRule "^category/dear-como/$" "/faq/" [R=301,L]
  # WordPress tag archive; lands in the filtered index
  RewriteRule "^tag/active-listening/$" "/faq/#tag=active-listening" [R=301,NE,L]
  # WordPress tag archive; lands in the filtered index
  RewriteRule "^tag/behavioural-patterns/$" "/faq/#tag=behavioural-patterns" [R=301,NE,L]
