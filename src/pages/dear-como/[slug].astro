---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PrevNext from '../../components/PrevNext.astro';
import ContactSection from '../../components/ContactSection.astro';
import { Image } from 'astro:assets';
import { formatDate, isoDate } from '../../lib/dates';
import { letters, hrefOf, INDEX_PATH } from '../../lib/collections';
import { normaliseTags, tagSlug } from '../../lib/tags';
import { excerpt } from '../../lib/excerpt';
import { articleJsonLd, pageTitle, BOOK_URL } from '../../lib/seo';
import { socialCard } from '../../lib/social-card';

export async function getStaticPaths() {
  // The same order the index shows, so "newer" and "older" mean what the
  // visitor just saw.
  const entries = await letters();
  return entries.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: entries[i - 1] ? { href: hrefOf(entries[i - 1]), title: entries[i - 1].data.title } : undefined,
      next: entries[i + 1] ? { href: hrefOf(entries[i + 1]), title: entries[i + 1].data.title } : undefined,
    },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const description = entry.data.seoMetadescription
  ?? entry.data.metaDescription
  ?? excerpt(entry.body ?? '', entry.data.title);
const tags = normaliseTags(entry.data.tags);
const url = new URL(`/dear-como/${entry.id}/`, Astro.site).toString();
const image = entry.data.featuredImage ? await socialCard(Astro.site, entry.data.featuredImage) : undefined;

const jsonLd = articleJsonLd({
  site: Astro.site, url, title: entry.data.title, description, image,
  published: entry.data.publishDate, tags,
});
---
<BaseLayout
  title={pageTitle(entry.data.seoTitle ?? entry.data.title)}
  description={description}
  canonical={entry.data.canonical}
  image={entry.data.featuredImage}
  jsonLd={jsonLd}
  ogType="article"
  markdown
>
  <div class="section--paper">
  <article class="wrap letter">
    <p class="detail-back"><a href={INDEX_PATH}>← All of Dear CoMo</a></p>
    <header class="detail-head">
      <p class="eyebrow">Dear CoMo</p>
      <h1>{entry.data.title}</h1>
      <div class="detail-meta">
        {entry.data.publishDate && (
          <time datetime={isoDate(entry.data.publishDate)}>{formatDate(entry.data.publishDate)}</time>
        )}
      </div>
      {tags.length > 0 && (
        <ul class="chips">
          {tags.map((t) => <li><a class="chip" href={`${INDEX_PATH}#tag=${tagSlug(t)}`}>{t}</a></li>)}
        </ul>
      )}
    </header>

    {entry.data.featuredImage && (
      <figure class="detail-figure prose">
        <Image src={entry.data.featuredImage} alt="" width={1200} height={630} />
      </figure>
    )}

    <div class="prose"><Content /></div>

    <div class="prose">
      <div class="panel-brand">
        <h2>Where this comes from</h2>
        <p>
          Every letter is grounded in <em>Collaborative Software Design</em>, and the
          chapters they point to are real chapters. If one left you wanting the long
          version, that is where it is.
        </p>
        <p><a class="btn btn--inverse" href={BOOK_URL} rel="noopener">Buy the book</a></p>
      </div>
      <PrevNext prev={prev} next={next} label="More letters" />
    </div>
  </article>
  </div>

  <ContactSection />
</BaseLayout>

<style>
  .letter { padding-block: var(--space-12); }
</style>
