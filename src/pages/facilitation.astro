---
/** The consulting page. `/facilitation/` because that is the live address —
 *  the menu calls it "Consulting" and the URL calls it facilitation, and the
 *  URL is the promise. */
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactSection from '../components/ContactSection.astro';
import { pageTitle, organisation, mailto, AUTHORS } from '../lib/seo';

const description =
  'Hire us to facilitate your software design. If you already know the power of '
  + 'EventStorming, Example Mapping, Wardley Mapping and the rest but need somebody '
  + 'to hold the room, that is what this is.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Software design facilitation',
  description,
  serviceType: 'Facilitation and consulting',
  provider: organisation(Astro.site),
  areaServed: 'Worldwide',
};
---
<BaseLayout title={pageTitle('Software design facilitation')} description={description} jsonLd={jsonLd}>
  <section class="hero">
    <div class="wrap hero-inner">
      <p class="eyebrow eyebrow--ink">You can hire us!</p>
      <h1>Software design facilitation</h1>
      <p class="hero-lede">
        Struggling as a software team to collaborate effectively with stakeholders and
        fully grasp the intricate context of your software system?
      </p>
      <div class="hero-actions">
        <a class="btn btn--primary" href={mailto(
          'Booking enquiry: consulting',
          'Hi,\n\nI would like to talk about consulting / facilitation.\n\nWhat we are working on:\nRough timing:\n\nThanks,\n',
        )}>Book consulting</a>
        <a class="btn btn--outline" href="/training/">Or see the training</a>
      </div>
    </div>
  </section>

  <div class="section section--paper">
    <div class="wrap prose">
      <p>
        Interested in exploring collaborative software design to boost stakeholder
        engagement and make well-informed design decisions that bridge the gap between
        stakeholders and development teams? Or perhaps you already recognize the power
        of collaborative modeling tools like EventStorming, Example Mapping, Business
        Model Canvas, User Story Mapping, Impact Mapping, Wardley Mapping and more, and
        need someone to facilitate?
      </p>
      <blockquote>
        You can hire us for all your software design facilitation needs if you lack
        that expertise in-house (yet).
      </blockquote>
      <p>
        We work with {AUTHORS.map((a) => a.name).join(', ')} — the authors of
        <em> Collaborative Software Design</em>. If what you need is for your own people
        to learn to do this, the <a href="/training/">workshops</a> are the other half
        of the same answer.
      </p>
    </div>
  </div>

  <ContactSection />
</BaseLayout>
