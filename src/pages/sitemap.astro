---
/** Every page on the site, on one page.
 *
 * Two different things are called a sitemap and this site has both:
 *
 *   - `/sitemap-index.xml`, which @astrojs/sitemap generates. That one is for
 *     crawlers, is listed in `robots.txt`, and no person should ever read it.
 *   - this page, which is for people — the one a footer links to, and the
 *     standard place to find a link you could not find in the menu. It matters
 *     more here than on most sites: the menu has five items and the site has
 *     more than thirty pages, because every Dear CoMo letter is one.
 *
 * NOTHING HERE IS TYPED OUT. Every list comes from the same source the real
 * page uses — `NAV` and `CHAPTERS` from lib/nav, the collections through
 * lib/collections — so a sitemap that has gone stale is not a thing that can
 * happen here. That is the failure mode of hand-written sitemaps and it is the
 * reason many of them are worse than none.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactSection from '../components/ContactSection.astro';
import { NAV, CHAPTERS } from '../lib/nav';
import { letters, trainings, hrefOf, INDEX_PATH } from '../lib/collections';
import { pageTitle, organisation, BOOK_URL } from '../lib/seo';

const allLetters = await letters();
const allTrainings = await trainings();

/** The pages the menu points at, flattened out of the dropdown. Two kinds of
 *  entry come out and neither belongs in a list of pages: the on-page anchors
 *  ("What's inside", "Contact"), because an anchor is a place on a page rather
 *  than a page; and Home, which is listed first by hand below. */
const menuPages = NAV
  .flatMap((n) => (n.children ? n.children : [n]))
  .filter((n) => n.href.startsWith('/') && !n.href.includes('#') && n.href !== '/');

const description =
  'Every page on collaborative-software-design.com: the book, the chapters, '
  + 'the workshops, and every letter in the Dear CoMo column.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Sitemap',
  description,
  url: new URL('/sitemap/', Astro.site).toString(),
  publisher: organisation(Astro.site),
};

const dateOf = (d?: Date) =>
  d ? new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : undefined;
---
<BaseLayout title={pageTitle('Sitemap')} description={description} jsonLd={jsonLd}>
  {/* `--ground`: the lede below carries a link, and this band is the orange,
      where the site's magenta link colour measures 2.74:1. */}
  <section class="hero section--ground">
    <div class="wrap hero-inner">
      <p class="eyebrow">Everything, in one place</p>
      <h1>Sitemap</h1>
      <p class="hero-lede">
        Every page on this site. If you are a crawler rather than a person, you
        want <a href="/sitemap-index.xml">the XML one</a> instead.
      </p>
    </div>
  </section>

  <section class="section section--paper" data-test="sitemap">
    <div class="wrap sitemap-grid">
      <div>
        <h2>Pages</h2>
        <ul class="sitemap-list">
          <li><a href="/">Home</a></li>
          {menuPages.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          <li><a href="/search/">Search</a></li>
          <li><a href="/privacy-policy/">Privacy policy</a></li>
        </ul>

        <h2>The book</h2>
        <ul class="sitemap-list">
          {CHAPTERS.map((c) => (
            <li><a href={c.href}>Chapter #{c.number} — {c.title}</a></li>
          ))}
          <li><a href={BOOK_URL} rel="noopener">Buy it at Manning</a></li>
        </ul>

        <h2>Workshops</h2>
        <ul class="sitemap-list">
          {allTrainings.map((t) => (
            <li><a href={`/training/${t.id}/`}>{t.data.title}</a></li>
          ))}
        </ul>

        <h2>Feeds</h2>
        <ul class="sitemap-list">
          <li><a href="/rss.xml">Dear CoMo, as RSS</a></li>
          <li><a href="/sitemap-index.xml">XML sitemap, for crawlers</a></li>
        </ul>
      </div>

      <div>
        <h2>Dear CoMo</h2>
        <p class="sitemap-count">
          {allLetters.length} letters — <a href={INDEX_PATH}>the whole column</a>,
          filterable by tag.
        </p>
        <ul class="sitemap-list">
          {allLetters.map((l) => (
            <li>
              <a href={hrefOf(l)}>{l.data.title}</a>
              {dateOf(l.data.publishDate) && <span class="sitemap-date">{dateOf(l.data.publishDate)}</span>}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <ContactSection />
</BaseLayout>

<style>
  .sitemap-grid { display: grid; grid-template-columns: 1fr; gap: var(--space-12); align-items: start; }
  .sitemap-grid h2 { font-size: var(--text-xl); margin-top: var(--space-10); }
  .sitemap-grid > div > h2:first-child { margin-top: 0; }
  .sitemap-list { list-style: none; margin: 0; padding: 0; }
  /* A 24px target. These are a list rather than a sentence, so the inline
     exception to WCAG 2.5.8 does not apply to them. */
  .sitemap-list li { display: flex; flex-wrap: wrap; gap: var(--space-3); align-items: baseline; margin-bottom: var(--space-2); }
  .sitemap-list a { display: inline-block; min-height: 24px; }
  .sitemap-date { font-size: var(--text-sm); color: var(--color-ink-muted); }
  .sitemap-count { font-size: var(--text-sm); margin-top: 0; }

  @media (min-width: 900px) {
    .sitemap-grid { grid-template-columns: 1fr 1fr; gap: var(--space-16); }
  }
</style>
