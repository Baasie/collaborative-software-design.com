---
/** The Dear CoMo index.
 *
 * At `/faq/` because that is where the WordPress site put it, and an address
 * is a promise. It is not a list of questions about the book. It is the
 * archive of the column, and the h1 says so, so that somebody arriving from a
 * "FAQ" link is not confused about what they are looking at.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import LetterRow from '../components/LetterRow.astro';
import TagFilter from '../components/TagFilter.astro';
import ContactSection from '../components/ContactSection.astro';
import { letters, tagCounts } from '../lib/collections';
import { pageTitle, organisation, mailto } from '../lib/seo';
import como from '../assets/dear-como.png';

const entries = await letters();
const tags = tagCounts(entries);

const description =
  'Dear CoMo answers the questions facilitators actually write in with: the '
  + 'colleague who takes over every meeting, the group that goes quiet, the team '
  + 'that clings to its own ideas. One question, one letter, every time.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Dear CoMo',
  description,
  url: new URL('/faq/', Astro.site).toString(),
  publisher: organisation(Astro.site),
};
---
<BaseLayout title={pageTitle('Dear CoMo')} description={description} jsonLd={jsonLd}>
  <section class="hero section--blue">
    <div class="wrap hero-inner faq-hero">
      {/* The column's own mark, the one the live page stamps above its title.
          First in the source so it opens the page on a phone the way it does
          there, and in the right column on a desktop, where it fills a half
          of the band that was otherwise empty blue.

          `alt=""` because the h1 beside it says Dear CoMo. A screen reader
          being told "drawing of a woman in a bonnet" learns nothing it can
          use. */}
      <Image class="como" src={como} alt="" role="presentation" widths={[160, 260, 520]}
             sizes="(min-width: 900px) 260px, 140px" loading="eager" />

      <div class="faq-hero-text">
      <p class="eyebrow eyebrow--ink">Questions and answers</p>
      <h1>Dear CoMo</h1>
      <p class="hero-lede">
        Somebody writes in with a question about a room that is not working. CoMo
        writes back. No framework to adopt and no maturity model to climb. Just what is
        actually happening between the people in the session, and what you can do about
        it on Monday.
      </p>
      <div class="hero-actions">
        <a class="btn btn--ink" href={mailto(
          'A question for Dear CoMo',
          'Dear CoMo,\n\n',
        )}>Ask CoMo a question</a>
      </div>
      </div>
    </div>
  </section>

  <div class="section section--paper">
    <div class="wrap">
      <TagFilter tags={tags} allLabel="All letters" />
      {entries.length > 0 ? (
        <>
          <ol class="letters">
            {entries.map((e) => <LetterRow entry={e} level={2} />)}
          </ol>
          {/* Reachable from a legacy /tag/ redirect for a tag no live letter
              carries any more, so it has to say something useful. */}
          <p class="empty js-filter-empty" hidden>
            No letters carry that topic yet. Pick another, or
            <a href="/faq/"> see all of them</a>.
          </p>
        </>
      ) : (
        <p class="empty">No letters have been published yet.</p>
      )}
    </div>
  </div>

  <ContactSection />
</BaseLayout>

<style>
  .faq-hero { display: grid; gap: var(--space-8); }
  /* A stamp, not a photograph: the drawing has a white ground of its own, so
     the ring is what makes it a mark rather than a picture that failed to
     load a background. */
  .como {
    width: 140px; height: auto;
    border-radius: 50%;
    border: 3px solid var(--color-ink);
    background: var(--color-paper);
  }

  @media (min-width: 900px) {
    /* `auto` rather than an even split: the lede keeps its measure and the
       mark keeps its size, and its right edge lands on the page's. */
    .faq-hero { grid-template-columns: 1fr auto; gap: var(--space-12); align-items: start; }
    .como { grid-column: 2; grid-row: 1; width: 260px; }
    .faq-hero-text { grid-column: 1; grid-row: 1; }
  }

  /* A ruled list, not a grid of boxes. The heavy rule is the lid: the rows
     under it read as one block somebody can run an eye down, which is the
     whole job of this page. */
  .letters {
    list-style: none;
    margin: var(--space-10) 0 0;
    padding: 0;
    border-top: 4px solid var(--color-ink);
  }
</style>
