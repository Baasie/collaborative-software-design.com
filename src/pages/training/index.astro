---
/** The workshop index.
 *
 * The live site has no such page: `/training/` IS the two-day Collaborative
 * Software Design workshop, written straight into WordPress, because for a
 * long time there was only one. There are five now, so this address becomes
 * the list and each workshop gets its own page.
 *
 * That makes this the one page on the site with nothing to be faithful TO, so
 * it is built out of the brand's own vocabulary instead: the band rhythm the
 * home page establishes, and the pink the live training page already used.
 *
 *   pink   the same #e69ec6 the workshop pages open with, so arriving at one
 *          from here is a continuation rather than a jump.
 *   white  the workshops, grouped by the heading they sit under in Notion.
 *   blue   the other half of the answer, hire us to facilitate instead.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactSection from '../../components/ContactSection.astro';
import heroWoman from '../../assets/home/hero-woman.png';
import { sessions, trainingsByFormat, trainings } from '../../lib/collections';
import { dateRange, todayISO, upcoming, upcomingFor, where } from '../../lib/sessions';
import { pageTitle, organisation, mailto, AUTHORS } from '../../lib/seo';

const groups = await trainingsByFormat();
const all = await trainings();

// Read once, so every row on the page agrees about what day it is.
const today = todayISO();
const runs = await sessions();
const nextFor = (slug: string) => upcomingFor(runs, slug, today)[0];

/** The next date as one string.
 *
 *  Built here rather than in the markup because JSX keeps the newlines an
 *  indented template introduces, and the first version rendered as
 *  "2026 , Amsterdam": a space before the comma and none after it. */
function nextLine(slug: string): string | undefined {
  const run = nextFor(slug);
  if (!run) return undefined;
  const place = where(run);
  return `Next: ${dateRange(run)}${place ? `, ${place}` : ''}`;
}
const anyUpcoming = upcoming(runs, today).length;

const description =
  'Hands-on workshops in the facilitation discipline behind good domain modelling '
  + 'decisions: reading the room, working with ranking and resistance, and closing '
  + 'on decisions that hold. Two-day deep dives and shorter formats.';

const enquiry = mailto(
  'Booking enquiry: training',
  'Hi,\n\nI would like to talk about a training.\n\nWhich workshop:\nGroup size:\nOnline or in person:\nRough timing:\n\nThanks,\n',
);

// An `ItemList` rather than one Course node: this page is the list, and each
// workshop has a page of its own carrying its own Course.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Training',
  description,
  publisher: organisation(Astro.site),
  itemListElement: all.map((t, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: new URL(`/training/${t.id}/`, Astro.site).toString(),
    name: t.data.title,
  })),
};
---
<BaseLayout title={pageTitle('Training')} description={description} jsonLd={jsonLd}>
  <section class="hire section--pink" data-test="training-hero">
    <div class="wrap hire-grid">
      <div>
        <p class="eyebrow">Bookings</p>
        <h1>Practise the moments that break a design session</h1>
        <p class="hire-lede">
          You will not sit and listen to theory. Every workshop puts you in the room,
          facilitating, getting it wrong, getting feedback, and going again. Facilitation
          is a skill, and skills are not acquired from slides. All formats run online or
          in person, in-house or open enrolment.
        </p>
      </div>
      <div class="hire-aside">
        <p class="hire-count">
          {all.length} workshops, run by the authors of the book:
          {AUTHORS.map((a) => a.name).join(', ')}.
        </p>
        {/* Only claim there are public dates when there are. An empty list is
            not a state to design around; it is the normal one between runs. */}
        {anyUpcoming > 0 && (
          <p class="hire-count">
            {anyUpcoming === 1 ? 'One public date is open.' : `${anyUpcoming} public dates are open.`}
          </p>
        )}
        <p><a class="btn btn--ink" href={enquiry}>Ask about a date</a></p>
      </div>
    </div>

    <Image class="hire-figure" src={heroWoman} alt="" widths={[280, 557]}
           sizes="(min-width: 900px) 557px, 280px" loading="eager" />
  </section>

  <div class="section section--paper">
    <div class="wrap">
      {all.length > 0 ? (
        [...groups].map(([format, items]) => (
          <section class="format-group">
            <h2>{format}</h2>
            <ul class="workshop-list">
              {items.map((t) => (
                <li class="workshop">
                  <h3><a class="workshop-link" href={`/training/${t.id}/`}>{t.data.title}</a></h3>
                  {nextLine(t.id) && <p class="workshop-next">{nextLine(t.id)}</p>}
                  {t.data.teaser && <p class="workshop-teaser">{t.data.teaser}</p>}
                  <p class="workshop-more" aria-hidden="true">See this workshop →</p>
                </li>
              ))}
            </ul>
          </section>
        ))
      ) : (
        /* Not "no workshops": the sync raises an alert when a page disappears
           from Notion, and an empty list here means the sync has not run, not
           that the business has stopped selling training. */
        <p>The workshop list is being updated.</p>
      )}
    </div>
  </div>

  <section class="section section--blue">
    <div class="wrap more-grid">
      <div>
        <p class="eyebrow">The other half of the answer</p>
        <h2>Or have us facilitate the session ourselves</h2>
        <p>
          A workshop teaches your own people to hold the room. If what you need is
          somebody to hold it for you, for a particular decision with a particular group,
          that is <a href="/facilitation/">consulting</a>. Same material, other side.
        </p>
        <p><a class="btn btn--ink" href="/facilitation/">See consulting</a></p>
      </div>
    </div>
  </section>

  <ContactSection />
</BaseLayout>

<style>
  .hire {
    position: relative; overflow: hidden;
    background: var(--color-ground-pink); color: var(--color-ink);
    padding-block: var(--space-12);
  }
  .hire-grid { position: relative; z-index: 1; display: grid; grid-template-columns: 1fr; gap: var(--space-10); align-items: start; }
  .hire h1 { font-size: clamp(2.25rem, 5.5vw, 3.5rem); line-height: 1.1; margin: 0 0 var(--space-8); }
  .hire-lede { font-size: var(--text-lg); line-height: 1.6; margin: 0; }
  .hire-count { margin: 0 0 var(--space-6); font-size: var(--text-sm); }
  .hire-figure {
    position: absolute; top: 0; right: 0; z-index: 0;
    width: 280px; height: auto; mix-blend-mode: lighten; pointer-events: none;
  }

  .format-group + .format-group { margin-top: var(--space-16); }
  .format-group h2 { margin-top: 0; }
  .workshop-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr; gap: var(--space-8); }
  /* A rule above each one rather than a box around it: the brand is
     square-cornered and heavy-ruled, and five long teasers in five bordered
     cards is a wall. */
  .workshop { position: relative; border-top: 4px solid var(--color-ink); padding-top: var(--space-5); }
  .workshop h3 { margin: 0 0 var(--space-3); font-size: var(--text-xl); }
  .workshop-link { color: var(--color-ink); }
  /* The whole block is the target, without nesting a second link inside the
     first. The title carries the href and this stretches its hit area. */
  .workshop-link::after { content: ''; position: absolute; inset: 0; }
  .workshop:hover .workshop-link { color: var(--color-brand); }
  /* Clamped. All five Notion pages carry a `Teaser` section and the lengths
     now sit between 175 and 420 characters, but that is still a factor of two,
     and an unclamped grid tracks the longest one. Five lines is enough for the
     shortest to fill and the longest to be cut somewhere sensible; the whole
     teaser is one click away on the workshop's own page. */
  .workshop-teaser {
    margin: 0 0 var(--space-4); color: var(--color-ink-muted);
    font-size: var(--text-sm); line-height: 1.8;
    display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 5; overflow: hidden;
  }
  .workshop-more { margin: 0; font-family: var(--font-body); font-size: var(--text-sm); color: var(--color-brand); }
  /* The next public date, where somebody scanning the list is looking for it.
     Ink on white, and set in the heading face so it reads as a fact about the
     workshop rather than as more of the teaser. */
  .workshop-next {
    margin: 0 0 var(--space-3); font-family: var(--font-heading); font-weight: 700;
    font-size: var(--text-base); letter-spacing: 0.02em;
  }

  .more-grid h2 { margin-top: 0; font-size: var(--text-2xl); }
  .more-grid p { max-width: 42rem; }

  @media (min-width: 900px) {
    .hire-grid { grid-template-columns: 1.58fr 1fr; gap: var(--space-16); }
    .hire-figure { width: 557px; }
    .workshop-list { grid-template-columns: 1fr 1fr; gap: var(--space-10) var(--space-12); }
  }
</style>
