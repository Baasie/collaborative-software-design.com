---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PrevNext from '../../components/PrevNext.astro';
import ContactSection from '../../components/ContactSection.astro';
import { Image } from 'astro:assets';
import { trainings } from '../../lib/collections';
import { courseJsonLd, pageTitle, BOOK_URL, mailto } from '../../lib/seo';
import { socialCard } from '../../lib/social-card';
import { excerpt } from '../../lib/excerpt';

export async function getStaticPaths() {
  const items = await trainings();
  return items.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: items[i - 1] ? { href: `/training/${items[i - 1].id}/`, title: items[i - 1].data.title } : undefined,
      next: items[i + 1] ? { href: `/training/${items[i + 1].id}/`, title: items[i + 1].data.title } : undefined,
    },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const description = entry.data.seoMetadescription
  ?? entry.data.teaser
  ?? excerpt(entry.body ?? '', entry.data.title);
const url = new URL(`/training/${entry.id}/`, Astro.site).toString();
const image = entry.data.featuredImage ? await socialCard(Astro.site, entry.data.featuredImage) : undefined;

const jsonLd = courseJsonLd({
  site: Astro.site, url, title: entry.data.title, description, image, format: entry.data.format,
});
---
<BaseLayout
  title={pageTitle(entry.data.seoTitle ?? entry.data.title)}
  description={description}
  image={entry.data.featuredImage}
  jsonLd={jsonLd}
  ogType="article"
  markdown
>
  <div class="section--paper">
  <article class="wrap training">
    <p class="detail-back"><a href="/training/">← All workshops</a></p>
    <header class="detail-head">
      {entry.data.format && <p class="eyebrow">{entry.data.format} workshop</p>}
      <h1>{entry.data.title}</h1>
      <p class="training-actions">
        <a class="btn btn--primary" href={mailto(
          `Booking enquiry: ${entry.data.title}`,
          `Hi,\n\nI would like to talk about running "${entry.data.title}".\n\nGroup size:\nOnline or in person:\nRough timing:\n\nThanks,\n`,
        )}>Ask about a date</a>
      </p>
    </header>

    {entry.data.featuredImage && (
      <figure class="detail-figure prose">
        <Image src={entry.data.featuredImage} alt="" width={1200} height={630} />
      </figure>
    )}

    <div class="prose"><Content /></div>

    <div class="prose">
      <div class="panel-brand">
        <h2>Bring this to your team</h2>
        <p>
          Every workshop runs online or in person, in-house for one organisation or as
          an open enrolment. Tell us the group, the format and roughly when, and we
          will come back with a date.
        </p>
        <p>
          <a class="btn btn--inverse" href={mailto(
            `Booking enquiry: ${entry.data.title}`,
            `Hi,\n\nI would like to talk about running "${entry.data.title}".\n\nGroup size:\nOnline or in person:\nRough timing:\n\nThanks,\n`,
          )}>Get in touch</a>
        </p>
      </div>
      <p>
        The material comes from <em>Collaborative Software Design</em>.
        <a href={BOOK_URL} rel="noopener">Buy the book</a> if you want the long version
        first.
      </p>
      <PrevNext prev={prev} next={next} label="More workshops" />
    </div>
  </article>
  </div>

  <ContactSection />
</BaseLayout>

<style>
  .training { padding-block: var(--space-12); }
  .training-actions { margin-top: var(--space-6); }
</style>
