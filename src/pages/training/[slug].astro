---
/** A workshop page.
 *
 * Shaped after the live `/training/` page, which is not an index at all. It is
 * ONE workshop, the two-day Collaborative Software Design one, written straight
 * into WordPress. There are five now, so that page becomes the index and this
 * template carries its look:
 *
 *   pink   #e69ec6 with the engraved woman at the right edge, blended with
 *          `lighten`. Left: the format as an eyebrow, the title at 56px, the
 *          teaser at 20px. Right: the booking buttons and, when there is one,
 *          the workshop's picture on a white plate.
 *   white  the body out of Notion.
 *   blue   #aec9e9, where the live page puts "Before the workshop" and
 *          "Audience". Here the other workshops and the book.
 *
 * The picture comes from the Notion page's COVER, which the sync downloads as
 * `featuredImage`. Anything inside the body comes with the body. Neither needs
 * anything doing here; see docs/content-model.md.
 */
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactSection from '../../components/ContactSection.astro';
import BookBar from '../../components/BookBar.astro';
import heroWoman from '../../assets/home/hero-woman.png';
import { sessions, trainings } from '../../lib/collections';
import { dateRange, todayISO, upcomingFor, where } from '../../lib/sessions';
import { courseJsonLd, pageTitle, BOOK_URL, mailto } from '../../lib/seo';
import { socialCard } from '../../lib/social-card';
import { excerpt } from '../../lib/excerpt';

export async function getStaticPaths() {
  const items = await trainings();
  const runs = await sessions();
  // `todayISO()` is read once here rather than per page, so every page in one
  // build agrees about what day it is.
  const today = todayISO();
  return items.map((entry) => ({
    params: { slug: entry.id },
    props: {
      entry,
      others: items.filter((o) => o.id !== entry.id),
      runs: upcomingFor(runs, entry.id, today),
    },
  }));
}

const { entry, others, runs } = Astro.props;
// `headings` is Astro's own reading of the rendered markdown, so the contents
// list below cannot disagree with the page: it IS the page's headings.
const { Content, headings } = await render(entry);
const contents = headings.filter((h) => h.depth === 2);
const description = entry.data.seoMetadescription
  ?? entry.data.teaser
  ?? excerpt(entry.body ?? '', entry.data.title);
const url = new URL(`/training/${entry.id}/`, Astro.site).toString();
const image = entry.data.featuredImage ? await socialCard(Astro.site, entry.data.featuredImage) : undefined;

const enquiry = mailto(
  `Booking enquiry: ${entry.data.title}`,
  `Hi,\n\nI would like to talk about running "${entry.data.title}".\n\nGroup size:\nOnline or in person:\nRough timing:\n\nThanks,\n`,
);

const jsonLd = courseJsonLd({
  site: Astro.site, url, title: entry.data.title, description, image, format: entry.data.format,
});
---
<BaseLayout
  title={pageTitle(entry.data.seoTitle ?? entry.data.title)}
  description={description}
  image={entry.data.featuredImage}
  jsonLd={jsonLd}
  ogType="article"
  markdown
>
  <section class="hire section--pink" data-test="workshop-hero">
    <div class="wrap hire-grid">
      <div>
        <p class="detail-back"><a href="/training/">← All workshops</a></p>
        {/* The format alone, not "{format} workshop". One group in Notion is
            called "1 day or less", which reads badly with "workshop" bolted
            on, and every one of these pages says what it is in its own first
            paragraph anyway. */}
        {entry.data.format && <p class="eyebrow">{entry.data.format}</p>}
        <h1>{entry.data.title}</h1>
        {entry.data.teaser && <p class="hire-lede">{entry.data.teaser}</p>}

        {/* What is on this page, and how much of it there is. Seven screens
            with no contents is a page you scroll rather than read. Built from
            the body's own h2s, so it cannot drift from what follows. */}
        {contents.length > 1 && (
          <nav class="toc" aria-label="On this page">
            <ul>
              {contents.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
            </ul>
          </nav>
        )}
      </div>

      <div class="hire-aside">
        {/* The dates come from the `Public trainings` database, and a run
            disappears the day after it ends. The WordPress page had this as a
            button somebody typed, which is why it still said June in
            November. See src/lib/sessions.ts. */}
        {runs.length > 0 ? (
          <div class="runs" data-test="runs">
            <h2 class="runs-head">Next dates</h2>
            <ul>
              {runs.map((r) => (
                <li class="run">
                  <p class="run-when">{dateRange(r)}</p>
                  <p class="run-where">
                    {where(r)}
                    {r.language && r.language !== 'English' && <span> · in {r.language}</span>}
                    {r.price != null && <span> · €{r.price.toLocaleString('en-GB')}</span>}
                  </p>
                  {r.status === 'Sold out'
                    ? <p class="run-sold">Sold out</p>
                    : r.tickets
                      ? <p><a class="btn btn--ink" href={r.tickets} rel="noopener">Book a place</a></p>
                      : <p><a class="btn btn--ink" href={enquiry}>Ask about this date</a></p>}
                </li>
              ))}
            </ul>
            <p class="runs-private">
              <a href={enquiry}>Or ask about running it in-house</a>
            </p>
          </div>
        ) : (
          <p class="hire-actions">
            <a class="btn btn--ink" href={enquiry}>Ask about a date</a>
          </p>
        )}
        {entry.data.featuredImage && (
          /* On a white plate, as the live page frames its illustration. The
             alt is empty because the picture illustrates the workshop rather
             than saying anything the page does not. */
          <figure class="hire-figure-plate">
            <Image src={entry.data.featuredImage} alt="" widths={[396, 792]}
                   sizes="(min-width: 900px) 396px, 90vw" />
          </figure>
        )}
      </div>
    </div>

    <Image class="hire-figure" src={heroWoman} alt="" widths={[280, 557]}
           sizes="(min-width: 900px) 557px, 280px" loading="eager" />
  </section>

  {/* No `.wrap`: the bands span the viewport and each child carries the text
      measure as padding. See the band rules in the stylesheet below. */}
  <article class="prose workshop-body"><Content /></article>

  <section class="section section--blue" data-test="more-workshops">
    <div class="wrap more-grid">
      <div>
        <p class="eyebrow">Bring this to your team</p>
        <h2>Online or in person, in-house or open enrolment</h2>
        <p>
          Tell us the group, the format and roughly when, and we will come back with a
          date. The material comes from <em>Collaborative Software Design</em>, so
          <a href={BOOK_URL} rel="noopener">buy the book</a> if you want the long
          version first.
        </p>
        <p><a class="btn btn--ink" href={enquiry}>Ask about a date</a></p>
      </div>

      {others.length > 0 && (
        <nav class="more-list" aria-label="Other workshops">
          <h3>Other workshops</h3>
          <ul>
            {others.map((o) => (
              <li>
                <a href={`/training/${o.id}/`}>{o.data.title}</a>
                {o.data.format && <span class="more-format">{o.data.format}</span>}
              </li>
            ))}
          </ul>
        </nav>
      )}
    </div>
  </section>

  <ContactSection />

  {/* Last in the DOM so it is last in the tab order. See BookBar.astro for why
      this is a following bar rather than a second button at the foot. */}
  <BookBar run={runs[0]} enquiry={enquiry} title={entry.data.title} />
</BaseLayout>

<script>
  import { initBookBar } from '../../scripts/book-bar';
  initBookBar();
</script>

<style>
  .hire {
    position: relative; overflow: hidden;
    background: var(--color-ground-pink); color: var(--color-ink);
    padding-block: var(--space-12);
  }
  .hire-grid { position: relative; z-index: 1; display: grid; grid-template-columns: 1fr; gap: var(--space-10); align-items: start; }
  .hire h1 { font-size: clamp(2rem, 4.5vw, 3.5rem); line-height: 1.1; margin: 0 0 var(--space-8); }
  .hire-lede { font-size: var(--text-lg); line-height: 1.6; margin: 0; }
  .hire-actions { margin: 0 0 var(--space-8); }
  .detail-back { margin: 0 0 var(--space-6); font-size: var(--text-sm); }

  /* Chips rather than a list: it is a map of the page, and a map should take
     one glance rather than a column. Ink on the pink, because the accent is
     3.85:1 on this ground. */
  .toc { margin-top: var(--space-8); }
  .toc ul { list-style: none; display: flex; flex-wrap: wrap; gap: var(--space-2); margin: 0; padding: 0; }
  .toc a {
    display: inline-flex; align-items: center; min-height: 32px;
    padding: var(--space-1) var(--space-4);
    background: var(--overlay-white-strong); color: var(--color-ink);
    font-size: var(--text-sm); text-decoration: none;
  }
  .toc a:hover { background: var(--color-ink); color: var(--on-colour); }

  /* The scheduled runs. A white plate, like the illustration below it, because
     this is the one block on the page somebody is looking FOR. */
  .runs { background: var(--color-paper); padding: var(--space-5); margin-bottom: var(--space-8); }
  .runs-head { margin: 0 0 var(--space-4); font-size: var(--text-lg); }
  .runs ul { list-style: none; margin: 0; padding: 0; }
  .run + .run { margin-top: var(--space-6); padding-top: var(--space-6); border-top: 2px solid var(--color-ink); }
  .run p { margin: 0 0 var(--space-3); }
  .run-when { font-family: var(--font-heading); font-weight: 700; font-size: var(--text-xl); line-height: 1.1; }
  .run-where { font-size: var(--text-sm); color: var(--color-ink-muted); }
  /* Not a button: a sold-out run is information, and a control that cannot be
     used is worse than a line of text saying why. */
  .run-sold { font-family: var(--font-body); text-transform: uppercase; letter-spacing: 0.07em; font-size: var(--text-button); }
  .runs-private { margin: var(--space-5) 0 0; font-size: var(--text-sm); }

  /* The white plate the live page frames its illustration with. */
  .hire-figure-plate { margin: 0; padding: var(--space-4); background: var(--color-paper); }
  .hire-figure-plate :global(img) { width: 100%; height: auto; }

  .hire-figure {
    position: absolute; top: 0; right: 0; z-index: 0;
    width: 280px; height: auto; mix-blend-mode: lighten; pointer-events: none;
  }

  /* THE BANDS.
   *
   * A divider in Notion is a seam, and each stretch between two seams gets its
   * own ground, which is what the live WordPress page does:
   *
   *     hero and About the workshop   pink   #e69ec6
   *     What You Will Learn           white
   *     Before the workshop, Audience blue   #aec9e9
   *
   * Measured off `/training/` rather than chosen. The fourth ground is the
   * grey the home page puts behind the talk, for the Agenda, which the live
   * page has no equivalent of.
   *
   * WHY IT IS DONE WITH SIBLING SELECTORS. The obvious way is to split the
   * rendered body at each `<hr>` and wrap the parts in sections. That breaks
   * every picture in the body: Astro resolves markdown images through the
   * `Content` component at build time, and the stored HTML still holds the
   * unresolved paths. So the document stays whole and the ground travels down
   * it instead.
   *
   * `hr:nth-of-type(n) ~ *` matches everything after that divider, so an
   * element after the third divider matches all three rules and the last one
   * declared wins. Which means these rules must stay in order, and a fifth
   * divider needs a fifth rule. */
  .workshop-body {
    overflow-x: clip;
    /* The SAME left edge every other block on this page uses: `.wrap` centres
       a 72rem box and pads it, which puts its content at 164px on a 1440
       screen. The first version centred a 46rem column in the viewport
       instead, which put the body at 352px while the hero above and the blue
       band below stayed at 164. A 188px jog in the middle of one page.
       `100%` and not `100vw`: the container is a child of `<main>`, so its
       width already excludes the scrollbar, which `100vw` does not. */
    --edge: max(var(--space-5), calc((100% - var(--wide-width)) / 2 + var(--space-5)));
  }
  .workshop-body :global(> *) {
    /* Text left-aligned at the page's edge and 46rem wide; the background
       still runs the full width of the band. */
    padding-left: var(--edge);
    padding-right: max(var(--space-5), calc(100% - var(--edge) - 46rem));
    /* Margins would leave the grounds showing through between blocks, so the
       rhythm is padding here. */
    margin-block: 0;
    padding-block: var(--space-3);
    background: var(--band);
  }
  /* Ground, and list marker, per band. The second band is "What you will
     learn", which is the one the live page ticks. */
  .workshop-body :global(> *) {
    --band: var(--color-ground-pink); --marker: disc; --tick: none; --tick-pad: 0;
  }
  .workshop-body :global(> hr:nth-of-type(1) ~ *) {
    --band: var(--color-paper); --marker: none; --tick: '✓'; --tick-pad: var(--space-8);
  }
  .workshop-body :global(> hr:nth-of-type(2) ~ *) {
    --band: var(--color-ground-blue); --marker: disc; --tick: none; --tick-pad: 0;
  }
  .workshop-body :global(> hr:nth-of-type(3) ~ *) { --band: var(--color-ground-grey); }
  .workshop-body :global(> hr:nth-of-type(4) ~ *) { --band: var(--color-paper); }
  .workshop-body :global(> hr:nth-of-type(5) ~ *) { --band: var(--color-ground-blue); }
  .workshop-body :global(> hr:nth-of-type(6) ~ *) { --band: var(--color-ground-grey); }

  /* The divider itself draws nothing. The change of ground is the seam. */
  .workshop-body :global(hr) { border: 0; height: 0; margin: 0; padding-block: 0; }

  /* Air at the top and bottom of every band, so a heading does not open one
     flush against the edge. `hr + *` and not `hr + h2`: a band can open with a
     pair of columns that carry their own headings, which is what "Before the
     workshop" beside "Audience" does. */
  .workshop-body :global(> hr + *) { padding-top: var(--space-12); margin-top: 0; }
  .workshop-body :global(> *:has(+ hr)) { padding-bottom: var(--space-12); }
  .workshop-body :global(> :first-child) { padding-top: var(--space-12); }
  .workshop-body :global(> :last-child) { padding-bottom: var(--space-16); }

  /* A link in this body can land on any of the four grounds, and the accent is
     only legible on three of them: 21:1 on the white, 12.3 on the blue, 17.6
     on the grey, and 3.85 on the pink, which is under what normal text needs.
     Ink reads on all four, and the underline `p a` already gives it is what
     marks it as a link. Same reasoning as the navigation. */
  .workshop-body :global(a) { color: var(--color-ink); }
  .workshop-body :global(a:hover) { text-decoration-thickness: 3px; }

  /* TWO COLUMNS, where the Notion page has them. The track widths are Notion's
     own ratios, carried through by the sync as `--tracks`, so dragging a
     column divider in Notion changes the page.

     One column below 900px. Two columns of monospace on a phone is about 20
     characters a line, which is not reading, it is a word ladder. */
  /* A pair of columns takes the whole row rather than the reading measure.
     Half of 46rem is about 30 characters of monospace, which is not a column,
     it is a gutter. The live page runs its two at 510px inside a 1080 row, and
     mirroring the left edge on the right gives very nearly that. */
  .workshop-body :global(> .cols) { padding-right: var(--edge); }
  .workshop-body :global(.cols) { display: grid; grid-template-columns: 1fr; gap: var(--space-8); }
  .workshop-body :global(.cols > .col > :first-child) { margin-top: 0; }
  @media (min-width: 900px) {
    .workshop-body :global(.cols) { grid-template-columns: var(--tracks, 1fr 1fr); gap: var(--space-12); }
  }

  /* `.prose` sets a 40rem measure for a letter. Here the measure lives on the
     children, so the container has to let go of it. */
  .workshop-body { max-width: none; }

  /* The magenta tick, scoped to the ONE list it came from.
     It was on every `ul` in the body, which put twenty of them on this page:
     the eight things you will learn, then the agenda, then the audience. A
     tick means "you get this", so ticking "Business Analysts & QA
     Professionals" reads oddly, and twenty in a row stops reading as
     anything.
     Keyed on the heading's slug, which Astro generates from the heading text.
     Rename that heading in Notion and the ticks quietly become plain bullets,
     which is the safe direction for a decoration to fail in. All five
     workshops use "What you will learn", so all five get them. */
  /* THE TICK, carried by the band rather than by a heading.
   *
   * It used to hang off `#what-you-will-learn + ul`, which broke the moment
   * that list moved inside a column: the heading's next sibling is the column
   * wrapper now, not the list. It was fragile anyway, since renaming the
   * heading in Notion silently took the ticks away.
   *
   * So it travels with the band, the same way the ground does. Custom
   * properties inherit, so a list nested any number of columns deep still
   * picks up whichever value the band above it set. */
  .workshop-body :global(ul) { list-style-type: var(--marker); }
  .workshop-body :global(li) { position: relative; padding-left: var(--tick-pad); }
  .workshop-body :global(li)::before {
    /* `content: none` generates nothing at all, so the bands that are not
       ticking pay for none of this. */
    content: var(--tick);
    position: absolute; left: 0; top: 0;
    color: var(--color-brand); font-weight: 700;
  }
  .workshop-body :global(li)::marker { color: var(--color-brand); }

  .more-grid { display: grid; grid-template-columns: 1fr; gap: var(--space-10); align-items: start; }
  .more-grid h2 { margin-top: 0; font-size: var(--text-2xl); }
  .more-list h3 { margin-top: 0; font-size: var(--text-lg); }
  .more-list ul { list-style: none; margin: 0; padding: 0; }
  .more-list li { margin-bottom: var(--space-4); }
  /* A 24px target: a column of links is a list, not a sentence. */
  .more-list a { display: inline-block; min-height: 24px; color: var(--color-ink); }
  .more-format { display: block; font-size: var(--text-sm); color: var(--color-ink-muted); }

  @media (min-width: 900px) {
    .hire-grid { grid-template-columns: 1.58fr 1fr; gap: var(--space-16); }
    .hire-figure { width: 557px; }
    .more-grid { grid-template-columns: 1.4fr 1fr; gap: var(--space-16); }
  }
</style>
