---
/** "Get in touch", the section every page on the live site ends with.
 *
 * The WordPress original is a form (Name, Email, Message, and a "I want to
 * book a: training / consulting" selector). A static site cannot process a
 * form post, so this is a `mailto:` instead, two of them, pre-filled with the
 * subject, so a booking enquiry still arrives labelled and the authors can
 * tell training from consulting without reading the body.
 *
 * That is a deliberate downgrade and it is worth knowing about: a mailto
 * exposes the address to scrapers and does nothing on a machine with no mail
 * client configured. If either becomes a problem the fix is a hosted form
 * endpoint, and this component is the only place that changes.
 */
import { Image } from 'astro:assets';
import { mailto, CONTACT_EMAIL, SOCIALS } from '../lib/seo';
import { NAV, CHAPTERS } from '../lib/nav';
import iconLinkedin from '../assets/icon-linkedin.png';
import iconBluesky from '../assets/icon-bluesky.png';

/** "Explore": every page on the site, in the one place a visitor looks for a
 *  link the five-item menu does not carry. The chapters especially, which the
 *  menu never lists at all.
 *
 *  BUILT FROM `NAV` AND `CHAPTERS`, not typed out. A hand-kept list of links is
 *  the thing that goes stale first and the reason so many footers point at
 *  pages that no longer exist. The anchors ("What's inside", "Contact") and
 *  Home are dropped: an anchor is a place on a page rather than a page, and
 *  Home is the wordmark. It used to flatten a dropdown out of `NAV` as well;
 *  the menu is flat now, so that step is gone.
 *
 *  The labels are the MENU's words, including "FAQ" for a page whose own
 *  heading says "Dear CoMo". That mismatch is deliberate and it is the live
 *  site's, `/faq/` is the address WordPress gave the column, and somebody
 *  hunting for the word they saw in the menu should find it here too.
 *
 *  A chapter goes in under its plain title, without the "#01" the home page
 *  gives it: a column of links reads better ragged-free, and the number means
 *  something in the book rather than here. */
const EXPLORE = [
  ...NAV.filter((n) => n.href.startsWith('/') && !n.href.includes('#') && n.href !== '/'),
  ...CHAPTERS.map((c) => ({ href: c.href, label: c.title })),
  { href: '/search/', label: 'Search' },
];

/** The two 50×50 black squares the live footer draws under "Follow us",
 *  matched to SOCIALS by name so neither list can gain an entry the other
 *  does not have. */
const ICONS: Record<string, ImageMetadata> = {
  LinkedIn: iconLinkedin,
  Bluesky: iconBluesky,
};
---
{/* ORANGE, not magenta. This band is the live site's footer template
    (`.et_pb_section_0_tb_footer`), and it is `#e37b45` with black type on
    every page. The same ground the page already sits on, so it needs no
    background of its own. */}
<section class="section section--ground" id="contact" data-test="contact">
  <div class="wrap contact-grid">
    <div>
      <p class="eyebrow">Contact</p>
      <h2>Get in touch</h2>
      <p>
        Any question about Collaborative Software Design, or want to book a
        training or consulting? We would love to hear from you.
      </p>
      <div class="hero-actions">
        <a class="btn btn--ink" href={mailto(
          'Booking enquiry: training',
          'Hi,\n\nI would like to talk about a training.\n\nGroup size:\nOnline or in person:\nRough timing:\n\nThanks,\n',
        )}>Book a training</a>
        <a class="btn btn--ink" href={mailto(
          'Booking enquiry: consulting',
          'Hi,\n\nI would like to talk about consulting / facilitation.\n\nWhat we are working on:\nRough timing:\n\nThanks,\n',
        )}>Book consulting</a>
      </div>
      <p class="contact-direct">
        Or write to <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
      </p>
    </div>
    <nav class="contact-explore" aria-label="Site">
      <h3>Explore</h3>
      <ul>
        {EXPLORE.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>

    <div>
      <h3>Follow us</h3>
      <ul class="contact-socials">
        {SOCIALS.map((s) => (
          <li>
            <a href={s.url} rel="noopener" aria-label={s.name}>
              <Image src={ICONS[s.name]} alt="" role="presentation" width={50} height={50} />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .contact-grid { display: grid; grid-template-columns: 1fr; gap: var(--space-10); }
  @media (min-width: 800px) { .contact-grid { grid-template-columns: 1.2fr 1fr; gap: var(--space-12); } }
  /* Three columns once there is room. The shape virtualddd.com's footer uses,
     and the reason this band looked half-empty before: the copy stops at 34rem
     and everything to the right of it was air. */
  @media (min-width: 1100px) { .contact-grid { grid-template-columns: 1.3fr 1fr 0.5fr; gap: var(--space-12); } }
  .contact-grid p { max-width: 34rem; }
  .contact-grid h3 { margin-top: 0; font-size: var(--text-lg); }

  .contact-explore ul { list-style: none; margin: 0; padding: 0; }
  .contact-explore li { margin-bottom: var(--space-2); }
  /* A 24px target: a column of links is a list, not a sentence, so the inline
     exception to WCAG 2.5.8 does not apply. They keep the underline `li a`
     gives them, on this band they are ink rather than magenta, so the rule
     under the word is the only thing marking them as links at all. */
  .contact-explore a { display: inline-block; min-height: 24px; font-size: var(--text-sm); }
  .contact-direct { margin-top: var(--space-6); font-size: var(--text-sm); }
  .contact-socials { list-style: none; display: flex; gap: var(--space-4); margin: 0; padding: 0; }
  .contact-socials a { display: inline-flex; }
  .contact-socials img { width: 50px; height: 50px; }
  .contact-socials a:hover img { opacity: 0.75; }
</style>
