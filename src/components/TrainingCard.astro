---
/** One workshop, as a card. */
import { Image } from 'astro:assets';

interface Props {
  entry: {
    id: string;
    data: { title: string; format?: string; teaser?: string; featuredImage?: ImageMetadata };
  };
  level?: 2 | 3;
}
const { entry, level = 3 } = Astro.props;
const Title = `h${level}` as 'h2' | 'h3';
---
<article class="card card--training" data-test="training-card" data-pagefind-ignore>
  {entry.data.featuredImage && (
    <div class="card-media"><Image src={entry.data.featuredImage} alt="" width={640} height={360} /></div>
  )}
  <div class="card-body">
    {entry.data.format && <p class="eyebrow">{entry.data.format}</p>}
    <Title><a class="card-link" href={`/training/${entry.id}/`}>{entry.data.title}</a></Title>
    {entry.data.teaser && <p class="card-excerpt">{entry.data.teaser}</p>}
    <p class="card-meta">Read the outline →</p>
  </div>
</article>

<style>
  /* A workshop is what the site asks people to act on, so its card carries a
     little more weight than a letter's: the brand rule along the top. */
  .card--training { border-top-width: 8px; border-top-color: var(--color-brand); }
</style>
